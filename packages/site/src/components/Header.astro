---
const tabs = ['all', 'dev', 'study', 'project', 'idea', 'docs'];
---
<header class="topbar">
  <a href="/brain/" class="logo">brain</a>
  <nav class="tabs">
    {tabs.map(tab => (
      <a
        href={tab === 'all' ? '/brain/' : `/brain/?tab=${tab}`}
        class="tab"
        data-tab={tab}
      >{tab}</a>
    ))}
  </nav>
  <button class="cmd-btn" id="cmd-open" aria-label="Abrir busca (⌘K)">
    <span class="key">⌘K</span>
    <span class="cmd-text">buscar</span>
    <span class="blink"></span>
  </button>
</header>
